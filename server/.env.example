# Example env file for Jaxx AI proxy (OpenRouter + Ollama)
# Copy to .env and fill real values before running/deploying

# Option A: OpenRouter (OpenRouter.ai)
OPENROUTER_KEY=your_openrouter_api_key_here
OPENROUTER_URL=
OPENROUTER_MODEL=gpt-4o-mini

# Option B: Ollama (self-hosted or cloud). If OLLAMA_URL is set, the proxy will prefer Ollama.
# Example local: http://localhost:11434
OLLAMA_URL=
OLLAMA_MODEL=your-ollama-model-name

# Client token the frontend must send in X-Client-Key header (recommended)
CLIENT_KEY=bbavjwbx

# Allowed origin for CORS (your GitHub Pages URL)
ALLOWED_ORIGIN=https://vandermerwejack611-cloud.github.io

# PORT when running express locally
PORT=3000
